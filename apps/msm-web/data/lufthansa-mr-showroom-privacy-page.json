    {
      "_key": "policy-2",
      "_type": "contentSection",
      "title": "Collecting Your Personal Data",
      "contentSize": "lg",
      "navPointName": "Collecting Your Personal Data",
      "content": [
        {
          "_key": "heading-16",
          "_type": "block",
          "style": "h3",
          "markDefs": [],
          "children": [
            {
              "_key": "text",
              "_type": "span",
              "marks": [],
              "text": "Personal Data"
            }
          ]
        },
        {
          "_key": "paragraph-16",
          "_type": "block",
          "style": "normal",
          "markDefs": [],
          "children": [
            {
              "_key": "span-0",
              "_type": "span",
              "marks": [],
              "text": "While using Our Service, We may ask You to provide Us with certain personally identifiable information that can be used to contact or identify You. Personally identifiable information may include, but is not limited to:"
            }
          ]
        },
        {
          "_key": "paragraph-17",
          "_type": "block",
          "style": "normal",
          "markDefs": [],
          "children": [
            {
              "_key": "span-0",
              "_type": "span",
