# Optional, set in the MSM Vercel project when available.
NEXT_PUBLIC_MSM_GOOGLE_MEASUREMENT_ID=

# Server-only secrets for preview, revalidation, contact submissions, and relationship sync.
SANITY_VIEWER_TOKEN=
SANITY_REVALIDATE_SECRET=
SANITY_API_WRITE_TOKEN=
