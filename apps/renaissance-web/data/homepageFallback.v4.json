  {
    "_key": "renaissance-stories-intro",
    "_type": "introBlockTypoSophisticated",
    "description": "A campaign only works if it reaches the right outlets and creators for your specific game - not a generic media list. We build the media mix around your title's genre, platform, and audience, then time outreach to the moments (announcement, preview, launch) that actually move coverage. Since 2015 we've run this for teams from first-time indie studios to publishers like GSC Game World and Funcom.",
    "header": {
      "_type": "peopleStepHeader",
      "mainHeadline": "Not sure which media and creators will actually move the needle for your launch?"
    },
    "navPointName": "Stories",
    "renaissanceHeadingTag": "h2",
    "renaissanceLayout": "compact"
  },
