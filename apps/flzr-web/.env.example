# Test-project defaults. Production rollout requires a separate environment review.
NEXT_PUBLIC_CHANNEL=flizrWeb
NEXT_PUBLIC_SANITY_PROJECT_ID=wu6i3y0h
NEXT_PUBLIC_SANITY_DATASET=dev-dataset
NEXT_PUBLIC_SANITY_API_VERSION=2025-09-16
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3000/studio
NEXT_PUBLIC_SITE_URL=https://flzr-monorepo-test.vercel.app

# Keeps the public test URL out of search and suppresses production tracking.
DEPLOYMENT_TIER=test

# Set in both Production and Preview on the dedicated Vercel test project.
MONOREPO_TEST_PROJECT=true
MONOREPO_TEST_SITE=flzr

# Optional, set in the FLZR Vercel project when available.
NEXT_PUBLIC_FLZR_GOOGLE_MEASUREMENT_ID=

# Server-only secrets for preview, revalidation, contact submissions, and relationship sync.
SANITY_VIEWER_TOKEN=
SANITY_REVALIDATE_SECRET=
SANITY_API_WRITE_TOKEN=

# Keep relationship reconciliation disabled on public test deployments.
NEXT_PUBLIC_ENABLE_RELATIONSHIP_SYNC=false
RELATIONSHIP_SYNC_ENABLED=false
SANITY_SYNC_SECRET=
