# Sanity
# Keep the frontend and Studio on the same project/dataset when debugging local content.
NEXT_PUBLIC_SANITY_PROJECT_ID=wu6i3y0h
NEXT_PUBLIC_SANITY_DATASET=dev-dataset
NEXT_PUBLIC_SANITY_API_VERSION=2025-09-16
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3000/studio

# Server-only Viewer token used by Draft Mode and live preview.
SANITY_VIEWER_TOKEN=

# Optional. If unset, the root app defaults to 1spWeb.
# Valid values: 1spWeb, flizrWeb, msmWeb, studioco2Web, renaissanceWeb
NEXT_PUBLIC_CHANNEL=1spWeb

# Optional site URL for local structured data/canonical checks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Central Studio Presentation tools. Override these in the Studio deployment
# so each named preview opens the matching site origin.
NEXT_PUBLIC_SANITY_STUDIO_1SP_PREVIEW_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SANITY_STUDIO_FLZR_PREVIEW_ORIGIN=http://localhost:3001
NEXT_PUBLIC_SANITY_STUDIO_MSM_PREVIEW_ORIGIN=http://localhost:3002
NEXT_PUBLIC_SANITY_STUDIO_RENAISSANCE_PREVIEW_ORIGIN=http://localhost:3003

# Deployment classification. Only the exact value "test" disables indexing,
# Google Analytics, and Cookiebot. Local development can keep "development".
DEPLOYMENT_TIER=development

# Vercel-only branch/project guard. Set this to true in both Production and
# Preview for the four dedicated monorepo test projects; leave it unset in
# existing production/prototype projects and ordinary local development.
MONOREPO_TEST_PROJECT=

# Required with MONOREPO_TEST_PROJECT=true. The 1SP test project uses "1sp";
# the nested projects use "msm", "flzr", and "renaissance" respectively.
MONOREPO_TEST_SITE=

# Relationship reconciliation mutates Sanity documents and is disabled by default.
# Keep both flags false/unset in production. A future server-side integration must
# also send SANITY_SYNC_SECRET as a Bearer token.
NEXT_PUBLIC_ENABLE_RELATIONSHIP_SYNC=false
RELATIONSHIP_SYNC_ENABLED=false
SANITY_SYNC_SECRET=
